{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Stores user setting sync, active theme, metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "activeTheme": { "type": "string" },
        "lastActive": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Character": {
      "title": "Character",
      "description": "Council character with custom roles and biometric profiles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "biometrics": { "type": "object" },
        "manifesto": { "type": "string" },
        "avatarUrl": { "type": "string" }
      },
      "required": ["id", "name", "role"]
    },
    "ScriptSection": {
      "title": "ScriptSection",
      "description": "Script block module for video series production",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "speaker": { "type": "string" },
        "voice": { "type": "string" },
        "content": { "type": "string" },
        "audioData": { "type": "string" },
        "mimeType": { "type": "string" },
        "duration": { "type": "number" },
        "isVoiceGenerating": { "type": "boolean" },
        "isAnimateGenerating": { "type": "boolean" },
        "animVideoUrl": { "type": "string" }
      },
      "required": ["id", "title", "speaker", "content"]
    },
    "ChatHistory": {
      "title": "ChatHistory",
      "description": "A message record inside the secure cognitive core chat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string" },
        "timestamp": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "role", "content", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Primary user profile database entry"
    },
    "/users/{userId}/characters/{characterId}": {
      "schema": "Character",
      "description": "Custom user-specific characters mapping their silicon synapses"
    },
    "/users/{userId}/scripts/{scriptId}": {
      "schema": "ScriptSection",
      "description": "Custom episode and script block components"
    },
    "/users/{userId}/chatHistory/{messageId}": {
      "schema": "ChatHistory",
      "description": "Chat transcript records between user and the Oracle central core"
    }
  }
}
