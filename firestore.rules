rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validates document ID string parameter to block characters or size exhaust attacks
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- ENTITY VALIDATORS ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && data.get('activeTheme', '') is string && data.get('activeTheme', '').size() <= 128
        && data.get('lastActive', '') is string && data.get('lastActive', '').size() <= 128
        && data.get('trailerUrl', '') is string && data.get('trailerUrl', '').size() <= 2048;
    }

    function isValidCharacter(data) {
      return data.keys().hasAll(['id', 'name', 'role', 'description'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 128
        && data.role is string && data.role.size() <= 256
        && data.description is string && data.description.size() <= 2048
        && data.get('avatar', '') is string && data.get('avatar', '').size() <= 2048
        && data.get('voice', '') is string && data.get('voice', '').size() <= 128
        && data.get('trailerUrl', '') is string && data.get('trailerUrl', '').size() <= 2048
        && data.get('manifesto', '') is string && data.get('manifesto', '').size() <= 65536
        && data.get('lipSyncUrl', '') is string && data.get('lipSyncUrl', '').size() <= 2048
        && data.get('animatedVideoUrl', '') is string && data.get('animatedVideoUrl', '').size() <= 2048
        && data.get('aestheticTheme', '') is string && data.get('aestheticTheme', '').size() <= 128
        && (data.get('syncSettings', null) == null || (
            data.syncSettings is map
            && data.syncSettings.get('phonemeSensitivity', 0.0) is number
            && data.syncSettings.get('jawRange', 0.0) is number
            && data.syncSettings.get('blinkFrequency', 0.0) is number
        ));
    }

    function isValidScriptSection(data) {
      return data.keys().hasAll(['id', 'title', 'content', 'status'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 256
        && data.content is string && data.content.size() <= 65536
        && data.status is string && (data.status == 'pending' || data.status == 'generating' || data.status == 'completed')
        && data.get('audioData', '') is string && data.get('audioData', '').size() <= 20000000
        && data.get('audioMimeType', '') is string && data.get('audioMimeType', '').size() <= 128
        && data.get('bRollUrl', '') is string && data.get('bRollUrl', '').size() <= 2048
        && data.get('bRollLabel', '') is string && data.get('bRollLabel', '').size() <= 256
        && data.get('isVoiceGenerating', false) is bool;
    }

    function isValidChatHistory(data) {
      return data.keys().hasAll(['id', 'role', 'content', 'timestamp'])
        && data.id is string && data.id.size() <= 128
        && data.role is string && (data.role == 'user' || data.role == 'assistant')
        && data.content is string && data.content.size() <= 65536
        && data.timestamp is string && data.timestamp.size() <= 128
        && data.get('createdAt', '') is string && data.get('createdAt', '').size() <= 128;
    }

    // --- COGNITIVE ROUTING & RULE MATCHING ---

    // Primary User Settings & Configuration
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) 
                     && incoming().uid == existing().uid; // Immutable user ID field matching
      allow delete, list: if false; // Protects PII data leaks from unauthorized scanning
    }

    // User Characters / Council Synapses
    match /users/{userId}/characters/{characterId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(characterId) && isValidCharacter(incoming());
      allow update: if isOwner(userId) && isValidId(characterId) && isValidCharacter(incoming())
                     && incoming().id == existing().id; // Enforce immutable document ID parameters
      allow delete: if isOwner(userId) && isValidId(characterId);
    }

    // Scripts and Story boards
    match /users/{userId}/scripts/{scriptId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(scriptId) && isValidScriptSection(incoming());
      allow update: if isOwner(userId) && isValidId(scriptId) && isValidScriptSection(incoming())
                     && incoming().id == existing().id; // Enforce immutable document ID parameters
      allow delete: if isOwner(userId) && isValidId(scriptId);
    }

    // Cognitive Core Chat history
    match /users/{userId}/chatHistory/{messageId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(messageId) && isValidChatHistory(incoming());
      allow update: if isOwner(userId) && isValidId(messageId) && isValidChatHistory(incoming())
                     && incoming().id == existing().id; // Immutable historic message logs
      allow delete: if isOwner(userId) && isValidId(messageId);
    }
  }
}
